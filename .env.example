APP_NAME=WhatsAppCodexBot
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://app:8000
APP_TIMEZONE=UTC
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Preencha com segredos independentes gerados localmente, nunca com estes campos vazios.
# Senhas usadas em URI (Redis/Evolution) devem ser hexadecimais.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
EVOLUTION_DB_PASSWORD=
REDIS_PASSWORD=
EVOLUTION_API_KEY=
WEBHOOK_SECRET=
RUNNER_TOKEN=

# Número internacional sem +, pontuação ou espaços; nenhuma normalização de país.
BOT_OWNER_NUMBER=
BOT_INSTANCE=owner-bot
BOT_TIMEOUT_SECONDS=300
BOT_PROMPT_MAX_BYTES=16384
BOT_RESPONSE_PART_CHARS=3000
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=low

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bot
DB_USERNAME=bot
DB_PASSWORD=
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_STORE=redis
SESSION_DRIVER=array
EVOLUTION_URL=http://evolution:8080
RUNNER_URL=http://codex-runner:8081
